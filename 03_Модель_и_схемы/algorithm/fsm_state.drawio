<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="m6-fsm" name="FSM states"><mxGraphModel dx="1660" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="fsm_title" label="FSM · ЦИКЛ УСПЕШНОЙ СОРТИРОВКИ&#10;Основной путь показан сплошными стрелками; исключения и все точные дуги — в FSM.md и transition_coverage.csv."><mxCell style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#172B34;" parent="1" vertex="1"><mxGeometry x="50" y="20" width="1460" height="68" as="geometry" /></mxCell></object><object id="state_INIT" label="&lt;b&gt;INIT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;readiness + safe state&lt;/font&gt;" state="INIT"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="50" y="125" width="230" height="82" as="geometry" /></mxCell></object><object id="state_OBSERVE" label="&lt;b&gt;OBSERVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fresh M4 frame&lt;/font&gt;" state="OBSERVE"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="340" y="125" width="230" height="82" as="geometry" /></mxCell></object><object id="state_SELECT" label="&lt;b&gt;SELECT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;track + slot reservation&lt;/font&gt;" state="SELECT"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="630" y="125" width="230" height="82" as="geometry" /></mxCell></object><object id="state_PLAN" label="&lt;b&gt;PLAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;full M5 preflight&lt;/font&gt;" state="PLAN"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="920" y="125" width="230" height="82" as="geometry" /></mxCell></object><object id="state_APPROACH" label="&lt;b&gt;APPROACH&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pregrasp route&lt;/font&gt;" state="APPROACH"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="1210" y="125" width="230" height="82" as="geometry" /></mxCell></object><object id="state_DESCEND" label="&lt;b&gt;DESCEND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;planned descent&lt;/font&gt;" state="DESCEND"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="1210" y="330" width="230" height="82" as="geometry" /></mxCell></object><object id="state_GRASP" label="&lt;b&gt;GRASP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GRASP_CLOSE&lt;/font&gt;" state="GRASP"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="920" y="330" width="230" height="82" as="geometry" /></mxCell></object><object id="state_VERIFY_HOLD" label="&lt;b&gt;VERIFY_HOLD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LIFT + fresh public evidence&lt;/font&gt;" state="VERIFY_HOLD"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="630" y="330" width="230" height="82" as="geometry" /></mxCell></object><object id="state_TRANSFER" label="&lt;b&gt;TRANSFER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;hold monitored&lt;/font&gt;" state="TRANSFER"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="340" y="330" width="230" height="82" as="geometry" /></mxCell></object><object id="state_PLACE" label="&lt;b&gt;PLACE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reserved slot only&lt;/font&gt;" state="PLACE"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="50" y="330" width="230" height="82" as="geometry" /></mxCell></object><object id="state_RELEASE" label="&lt;b&gt;RELEASE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fresh empty-gripper proof&lt;/font&gt;" state="RELEASE"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="50" y="535" width="230" height="82" as="geometry" /></mxCell></object><object id="state_VERIFY_PLACE" label="&lt;b&gt;VERIFY_PLACE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fresh public class/zone/slot after retreat&lt;/font&gt;" state="VERIFY_PLACE"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="630" y="535" width="230" height="82" as="geometry" /></mxCell></object><object id="state_RETREAT" label="&lt;b&gt;RETREAT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;M5 safe retreat clears tray view&lt;/font&gt;" state="RETREAT"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="340" y="535" width="230" height="82" as="geometry" /></mxCell></object><object id="state_RECOVER" label="&lt;b&gt;RECOVER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bounded, feedback-confirmed&lt;/font&gt;" state="RECOVER"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="460" y="755" width="230" height="82" as="geometry" /></mxCell></object><object id="state_SAFE_STOP" label="&lt;b&gt;SAFE_STOP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;latched; no automatic release&lt;/font&gt;" state="SAFE_STOP"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE8E6;strokeColor=#B42318;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="870" y="755" width="230" height="82" as="geometry" /></mxCell></object><object id="state_DONE" label="&lt;b&gt;DONE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;batch ended; success rate is separate&lt;/font&gt;" state="DONE"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F4EA;strokeColor=#1F4E79;strokeWidth=2;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;shadow=0;" parent="1" vertex="1"><mxGeometry x="50" y="755" width="230" height="82" as="geometry" /></mxCell></object><object id="main_01" label="" transition="INIT-&gt;OBSERVE"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_INIT" target="state_OBSERVE"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_02" label="" transition="OBSERVE-&gt;SELECT"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_OBSERVE" target="state_SELECT"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_03" label="" transition="SELECT-&gt;PLAN"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_SELECT" target="state_PLAN"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_04" label="" transition="PLAN-&gt;APPROACH"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_PLAN" target="state_APPROACH"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_05" label="" transition="APPROACH-&gt;DESCEND"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_APPROACH" target="state_DESCEND"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_06" label="" transition="DESCEND-&gt;GRASP"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_DESCEND" target="state_GRASP"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_07" label="" transition="GRASP-&gt;VERIFY_HOLD"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_GRASP" target="state_VERIFY_HOLD"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_08" label="" transition="VERIFY_HOLD-&gt;TRANSFER"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_VERIFY_HOLD" target="state_TRANSFER"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_09" label="" transition="TRANSFER-&gt;PLACE"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_TRANSFER" target="state_PLACE"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_10" label="" transition="PLACE-&gt;RELEASE"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_PLACE" target="state_RELEASE"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_11" label="" transition="RELEASE-&gt;RETREAT"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_RELEASE" target="state_RETREAT"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_12" label="" transition="RETREAT-&gt;VERIFY_PLACE"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;" parent="1" edge="1" source="state_RETREAT" target="state_VERIFY_PLACE"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="main_13" label="" transition="VERIFY_PLACE-&gt;OBSERVE"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#385D7A;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" parent="1" edge="1" source="state_VERIFY_PLACE" target="state_OBSERVE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620" y="576" /><mxPoint x="1620" y="230" /><mxPoint x="570" y="230" /></Array></mxGeometry></mxCell></object><object id="exception_policy" label="&lt;b&gt;Отклонения от основного пути&lt;/b&gt;&lt;br&gt;DONE: валидная пустая сцена подтверждена 3 раз.&lt;br&gt;RECOVER: только bounded действие при подтверждённом состоянии без груза.&lt;br&gt;SAFE_STOP: неизвестный/удерживаемый груз, fatal mismatch, исчерпанный recovery или emergency.&lt;br&gt;Неразрешённые дуги не предполагаются: переходы ограничены TRANSITIONS."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FA;strokeColor=#AAB7C4;fontColor=#172B34;fontSize=12;align=left;verticalAlign=middle;spacing=10;" parent="1" vertex="1"><mxGeometry x="1210" y="720" width="390" height="160" as="geometry" /></mxCell></object><object id="fsm_note" label="Карта показывает 13 основных состояний цикла. Отдельные исходы DONE / RECOVER / SAFE_STOP указаны ниже; точные допустимые рёбра, guard, тайм-ауты и причины отказа полностью перечислены в FSM.md и transition_coverage.csv."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7C4;fontColor=#172B34;fontSize=11;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1"><mxGeometry x="50" y="925" width="1550" height="62" as="geometry" /></mxCell></object></root></mxGraphModel></diagram></mxfile>