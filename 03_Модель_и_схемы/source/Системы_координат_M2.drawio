        <mxCell id="21" value="T_A_B переводит координаты из B в A: p_A = T_A_B · p_B. Столбцовые векторы; длина — m, угол — rad." style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#34495E;fontSize=11;fontFamily=Arial;align=left;verticalAlign=middle;rounded=0;opacity=100;" vertex="1" parent="1">
