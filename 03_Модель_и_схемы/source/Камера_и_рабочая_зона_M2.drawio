        </mxCell>
        <mxCell id="47" value="Камера покрывает весь стол по идеальной pinhole-геометрии. Перекрытие звеньями и точность цветовой локализации проверяет M4." style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#7A4B17;fontSize=11;fontFamily=Arial;align=left;verticalAlign=middle;rounded=0;opacity=100;" vertex="1" parent="1">
